<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Backentec\ScrollToTop\Helper\Data $helperData */
$helperData = $this->helper(\Backentec\ScrollToTop\Helper\Data::class);

$position = $block->escapeHtmlAttr($helperData->getPosition());
$style    = $block->escapeHtmlAttr($helperData->getStyle());

$positionClass = $position === 'left' ? 'left-8' : 'right-8';
$styleClass    = $style === 'square'  ? 'rounded' : 'rounded-full';
?>
<div x-data="scrollToTop()"
     x-cloak
     @scroll.window="onScroll()"
     class="fixed bottom-8 <?= /* @noEscape */ $positionClass ?> z-50">
    <button x-show="visible"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-4"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 translate-y-4"
            @click="scrollUp()"
            class="p-2 bg-white border border-black <?= /* @noEscape */ $styleClass ?> shadow-md
                   hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black"
            aria-label="<?= $block->escapeHtmlAttr(__('Scroll to top')) ?>"
            title="<?= $block->escapeHtmlAttr(__('Scroll to top')) ?>">
        <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"
             aria-hidden="true" focusable="false">
            <path d="M440-160v-487L216-423l-56-57 320-320 320 320-56 57-224-224v487h-80Z"
                  fill="currentColor"/>
        </svg>
    </button>
</div>
<script>
    function scrollToTop() {
        return {
            visible: false,
            onScroll() {
                this.visible = window.scrollY > 100;
            },
            scrollUp() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        };
    }
</script>
