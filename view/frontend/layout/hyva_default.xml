<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <referenceBlock name="backentec_scrolltotop" remove="true"/>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block name="backentec_scrolltotop_hyva"
                   template="Backentec_ScrollToTop::hyva/scroll-to-top-button.phtml"
                   ifconfig="scrolltotop/general/enabled"/>
        </referenceContainer>
    </body>
</page>
